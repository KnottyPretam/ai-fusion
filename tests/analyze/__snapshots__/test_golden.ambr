          'R1',
          'R2',
          'R3',
        ]),
        'statement': 'The accelerometer gives an absolute, drift-free reference for roll and pitch but is noisy and corrupted by linear acceleration.',
        'topic': 'Accelerometer as gravity reference',
      }),
      dict({
        'models': list([
          'R1',
          'R2',
          'R3',
        ]),
        'statement': 'A complementary filter or Kalman filter uses the gyroscope for short-term dynamics and the accelerometer to bound long-term drift.',
        'topic': 'Fusion method',
      }),
      dict({
        'models': list([
          'R1',
          'R2',
          'R3',
        ]),
        'statement': 'Yaw is not observable from gravity, so heading needs a magnetometer or another aiding source.',
        'topic': 'Yaw observability',
      }),
    ]),
    'divergences': list([
    ]),
  })
