# Triplex — copy to .env (gitignored). Single provider key: OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP_REFERER=http://localhost:5173
# HOST=127.0.0.1
# PORT=8001
# DATA_DIR=./data
# MOCK_OPENROUTER=0
# MOCK_SCENARIO=planted_factual
# MOCK_FIXTURES_DIR=backend/llm/fixtures
# MOCK_RECORD_DIR=
# MOCK_DELAY_MS=0
# SESSION_COST_CAP_USD=10
# REQUEST_TIMEOUT_S=300
# CATALOG_TTL_S=86400
# LOG_LEVEL=INFO

# Per-slot defaults (spec R2: settable from the config file as well as the UI); defaults shown
# SLOT_CLAUDE_MODEL=anthropic/claude-opus-5
# SLOT_CLAUDE_EFFORT=medium
# SLOT_CHATGPT_MODEL=openai/gpt-5.6-sol
# SLOT_CHATGPT_EFFORT=medium
# SLOT_GROK_MODEL=x-ai/grok-4.6
# SLOT_GROK_EFFORT=medium
# ANALYST_MODEL=openai/gpt-5.6-luna
# FUSION_MAX_ITERATIONS=2
# MATERIALITY_MIN=medium
# GROUNDED_DEFAULT=0

# Desktop (read by the Electron launcher / desktop backend) — docs/desktop-contract.md §5–§6. All optional;
# defaults shown. Electron reads the TRIPLEX_* keys from its own environment (not from this file); the
# desktop backend it spawns gets PORT=8021 HOST=127.0.0.1 DATA_DIR=<userData>/data TRIPLEX_DESKTOP=1 and a
# per-launch BRIDGE_TOKEN from the launcher, never OPENROUTER_API_KEY.
# TRIPLEX_RENDERER_URL=http://127.0.0.1:8021/app/   # dev: http://localhost:5184 (scripts/desktop_dev.sh)
# TRIPLEX_BACKEND_PORT=8021
# TRIPLEX_BACKEND_URL=                              # attach to a running backend instead of spawning one (Stage 2)
# TRIPLEX_DATA_DIR=~/.config/triplex-desktop/data    # default <userData>/data
# TRIPLEX_USER_DATA_DIR=~/.config/triplex-desktop    # app.setPath('userData') before ready; temp dir for e2e
# TRIPLEX_SITES_JSON=                               # JSON deep-merged over SITES (tests point every site at the fake site)
# TRIPLEX_GROK_SURFACE=grok.com                     # x.com → https://x.com/i/grok (unverified escape hatch)
# TRIPLEX_SELECTORS_FILE=                           # default <userData>/selectors.json
# TRIPLEX_CHROMIUM_FLAGS=                           # allow-list: --ignore-gpu-blocklist|--disable-gpu|--disable-gpu-compositing|--use-gl=*|--enable-features=*|--disable-features=*
# TRIPLEX_DISABLE_GPU=0                             # 1 = --disable-gpu
# TRIPLEX_E2E_APP=0                                 # 1 = expose global.__triplexTest and refuse non-loopback site URLs
# TRIPLEX_FAKE_PORT=5199                            # desktop/test/fake-site/serve.js
# TRIPLEX_OLLAMA=0                                  # 1 = export OLLAMA_* to the spawned backend (Stage 3)
# BRIDGE_TOKEN=                                     # set per launch by Electron; unset → the backend accepts any hello + WARNING
# BRIDGE_TIMEOUT_S=600                              # no `result` within this → cancel + slot_error timeout
# BRIDGE_ACCEPT_TIMEOUT_S=15                        # no accepted/rejected within this → bridge_no_ack
# BRIDGE_PING_S=20                                  # two missed pongs → close 1011
# TRIPLEX_DESKTOP=0                                 # 1 = only web:<slot> / ollama:<name> models (anything else → transport_disabled)
# TRIPLEX_APP_DIR=                                  # static renderer dir served at /app/ (frontend/dist); unset → 404
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODELS=hermes3                             # comma-separated names listed as ollama:<name> in the desktop catalog
