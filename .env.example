# Triplex — copy to .env (gitignored). Single provider key: OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP_REFERER=http://localhost:5173
# HOST=127.0.0.1
# PORT=8001
# DATA_DIR=./data
# MOCK_OPENROUTER=0
# MOCK_SCENARIO=planted_factual
# MOCK_FIXTURES_DIR=backend/llm/fixtures
# MOCK_RECORD_DIR=
# MOCK_DELAY_MS=0
# SESSION_COST_CAP_USD=10
# REQUEST_TIMEOUT_S=300
# CATALOG_TTL_S=86400
# LOG_LEVEL=INFO

# Per-slot defaults (spec R2: settable from the config file as well as the UI); defaults shown
# SLOT_CLAUDE_MODEL=anthropic/claude-opus-5
# SLOT_CLAUDE_EFFORT=medium
# SLOT_CHATGPT_MODEL=openai/gpt-5.6-sol
# SLOT_CHATGPT_EFFORT=medium
# SLOT_GROK_MODEL=x-ai/grok-4.6
# SLOT_GROK_EFFORT=medium
# ANALYST_MODEL=openai/gpt-5.6-luna
# FUSION_MAX_ITERATIONS=2
# MATERIALITY_MIN=medium
# GROUNDED_DEFAULT=0
