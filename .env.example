# Triplex — copy to .env (gitignored). Single provider key: OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP_REFERER=http://localhost:5173
# HOST=127.0.0.1
# PORT=8001
# DATA_DIR=./data
# MOCK_OPENROUTER=0
# MOCK_SCENARIO=planted_factual
# MOCK_FIXTURES_DIR=backend/llm/fixtures
# MOCK_RECORD_DIR=
# MOCK_DELAY_MS=0
# SESSION_COST_CAP_USD=10
# REQUEST_TIMEOUT_S=300
# CATALOG_TTL_S=86400
# LOG_LEVEL=INFO
