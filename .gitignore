# secrets
.env
.env.*
!.env.example
# runtime data
data/
*.log
# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
# node / vite
node_modules/
frontend/dist/
frontend/node_modules/.vite/
# test artefacts
playwright-report/
test-results/
frontend/test-results/
# claude code agent worktrees live inside the repo
.claude/worktrees/
# desktop (Electron) — docs/desktop-contract.md; node_modules/ and data/ above already cover these, listed explicitly
desktop/node_modules/
desktop/test-results/
desktop/playwright-report/
data/e2e-desktop/

# packaging (scripts/package.sh) — every artifact is generated, none is committed.
# NOTE: .gitignore has no trailing comments; a pattern with one matches nothing.
# build/ holds pyinstaller/, pyinstaller-work/ and dist/ (AppImage, deb, pacman, nsis).
build/
packaging/__pycache__/
*.AppImage
*.deb
*.pacman
*.rpm
